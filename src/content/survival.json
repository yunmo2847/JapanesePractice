[
  {"id": "sv-etto", "cat": "stall", "ja": "えっと…", "ko": "음… / 그러니까…", "register": "both", "example": {"ja": "えっと…、趣味{しゅみ}はゲームです。", "ko": "음… 취미는 게임이에요."}, "tip": "생각할 때 침묵하지 말고 소리를 내요. 일본 사람들은 침묵보다 「えっと」를 훨씬 편하게 느껴요."},
  {"id": "sv-uun", "cat": "stall", "ja": "うーん…", "ko": "음…", "register": "both", "tip": "대답을 고민할 때. 「うーん、そうですね…」처럼 이어 써도 좋아요."},
  {"id": "sv-ano", "cat": "stall", "ja": "あの…", "ko": "저기… (말 꺼낼 때)", "register": "both", "example": {"ja": "あの…、ちょっといいですか。", "ko": "저기… 잠깐 괜찮아요?"}},
  {"id": "sv-soudesune", "cat": "stall", "ja": "そうですね…", "ko": "글쎄요… (생각할 시간 벌기)", "register": "polite", "example": {"ja": "そうですね…、ラーメンが好{す}きです。", "ko": "글쎄요… 라멘을 좋아해요."}},
  {"id": "sv-nanka", "cat": "stall", "ja": "なんか…", "ko": "뭔가… / 그냥…", "register": "casual", "example": {"ja": "なんか、眠{ねむ}い。", "ko": "뭔가 졸려."}, "tip": "말 앞에 붙이는 습관어예요. 너무 많이 쓰면 어려 보이니 적당히."},
  {"id": "sv-nanteiu", "cat": "stall", "ja": "何{なん}て言{い}うんだろう…", "ko": "뭐라고 하지…", "register": "both", "example": {"ja": "何{なん}て言{い}うんだろう…、ちょっと難{むずか}しいです。", "ko": "뭐라고 하지… 좀 어렵네요."}},
  {"id": "sv-chotto-matte", "cat": "stall", "ja": "ちょっと待{ま}ってください。", "ko": "잠깐만요.", "register": "polite"},
  {"id": "sv-mitaina", "cat": "paraphrase", "ja": "〜みたいなもの", "ko": "~같은 것", "register": "both", "example": {"ja": "韓国{かんこく}のお祭{まつ}りみたいなものです。", "ko": "한국의 축제 같은 거예요."}},
  {"id": "sv-tsukau", "cat": "paraphrase", "ja": "〜するときに使{つか}うもの", "ko": "~할 때 쓰는 것", "register": "both", "example": {"ja": "髪{かみ}を乾{かわ}かすときに使{つか}うものです。", "ko": "머리 말릴 때 쓰는 거예요."}},
  {"id": "sv-kantan", "cat": "paraphrase", "ja": "簡単{かんたん}に言{い}うと…", "ko": "간단히 말하면…", "register": "both"},
  {"id": "sv-eigo", "cat": "paraphrase", "ja": "英語{えいご}で言{い}うと…", "ko": "영어로 하면…", "register": "both", "example": {"ja": "英語{えいご}で言{い}うと、\"homework\"です。", "ko": "영어로 하면 homework예요."}},
  {"id": "sv-nihongo-de", "cat": "paraphrase", "ja": "日本語{にほんご}で何{なん}て言{い}いますか。", "ko": "일본어로 뭐라고 해요?", "register": "polite"},
  {"id": "sv-mouichido", "cat": "check", "ja": "もう一度{いちど}お願{ねが}いします。", "ko": "한 번 더 말해 주세요.", "register": "polite"},
  {"id": "sv-moikkai", "cat": "check", "ja": "え、もう一回{いっかい}いいですか。", "ko": "네? 한 번만 더 말해 줄래요?", "register": "polite", "tip": "「もう一度お願いします」보다 일상적이에요. 못 들었을 때 망설이지 말고 써요."},
  {"id": "sv-yukkuri", "cat": "check", "ja": "ゆっくりお願{ねが}いします。", "ko": "천천히 말해 주세요.", "register": "polite"},
  {"id": "sv-douiu", "cat": "check", "ja": "〜ってどういう意味{いみ}ですか。", "ko": "~가 무슨 뜻이에요?", "register": "polite", "example": {"ja": "「やばい」ってどういう意味{いみ}ですか。", "ko": "'야바이'가 무슨 뜻이에요?"}},
  {"id": "sv-ttekoto", "cat": "check", "ja": "〜ってことですか。", "ko": "~라는 거예요?", "register": "polite", "tip": "들은 내용을 내 말로 확인할 때 써요. 예: 「明日休みってことですか。」(내일 쉰다는 거예요?)"},
  {"id": "sv-wakaranai", "cat": "check", "ja": "すみません、よくわかりません。", "ko": "죄송해요, 잘 모르겠어요.", "register": "polite"},
  {"id": "sv-san-wa", "cat": "check", "ja": "〇〇さんは?", "ko": "○○ 씨는요? (되묻기)", "register": "polite", "example": {"ja": "私{わたし}は犬{いぬ}が好{す}きです。ユイさんは?", "ko": "저는 개를 좋아해요. 유이 씨는요?"}},
  {"id": "sv-doudesuka", "cat": "check", "ja": "〇〇さんはどうですか。", "ko": "○○ 씨는 어때요?", "register": "polite"},
  {"id": "sv-hee", "cat": "aizuchi", "ja": "へえ!", "ko": "오! / 그렇구나!", "register": "both", "tip": "말끝을 올리면 '오~ 그래?' 하는 관심 표현. 상대 말에 계속 반응해 주는 게 일본식 대화예요."},
  {"id": "sv-unun", "cat": "aizuchi", "ja": "うんうん。", "ko": "응응. (듣고 있어)", "register": "casual", "tip": "친구 말을 들으면서 고개와 함께. 정중하게는 「はい、はい」."},
  {"id": "sv-tashikani", "cat": "aizuchi", "ja": "たしかに！", "ko": "맞아, 그러네!", "register": "both", "tip": "상대 의견에 동의할 때. 일본 학생들이 정말 많이 써요."},
  {"id": "sv-wakarimasu", "cat": "aizuchi", "ja": "わかります！", "ko": "공감해요! / 맞아요!", "register": "polite", "tip": "'이해해요'가 아니라 '나도 그래요'라는 공감이에요. 친구끼리는 「わかる〜！」."},
  {"id": "sv-desuyone", "cat": "aizuchi", "ja": "ですよね！", "ko": "그쵸!", "register": "polite", "tip": "상대 말에 강하게 동의할 때. 친구끼리는 「だよね！」."},
  {"id": "sv-majide", "cat": "aizuchi", "ja": "マジで？", "ko": "진짜?", "register": "casual", "tip": "친구끼리만 써요. 선생님이나 어른에게는 「本当ですか」."},
  {"id": "sv-sorena", "cat": "aizuchi", "ja": "それな！", "ko": "그니까! / 내 말이!", "register": "casual", "tip": "친구 말에 완전 동의할 때. 학생들 사이에서 많이 써요. 어른 앞에서는 쓰지 않아요."},
  {"id": "sv-soudesuka", "cat": "aizuchi", "ja": "そうですか。", "ko": "그래요?", "register": "polite"},
  {"id": "sv-sounandesu", "cat": "aizuchi", "ja": "そうなんですね。", "ko": "그렇군요.", "register": "polite"},
  {"id": "sv-iidesune", "cat": "aizuchi", "ja": "いいですね!", "ko": "좋네요!", "register": "polite"},
  {"id": "sv-sugoi", "cat": "aizuchi", "ja": "すごいですね!", "ko": "대단하네요!", "register": "polite"},
  {"id": "sv-watashimo", "cat": "aizuchi", "ja": "私{わたし}もです!", "ko": "저도요!", "register": "polite"},
  {"id": "sv-tokorode", "cat": "switch", "ja": "ところで、", "ko": "그런데 (화제 전환)", "register": "both"},
  {"id": "sv-souieba", "cat": "switch", "ja": "そういえば、", "ko": "그러고 보니", "register": "both"},
  {"id": "sv-hanashikawaru", "cat": "switch", "ja": "話{はなし}変{か}わるけど、", "ko": "다른 얘긴데,", "register": "casual", "tip": "화제를 바꿀 때 친구끼리. 정중하게는 「ところで」."},
  {"id": "sv-tomoimasu", "cat": "opinion", "ja": "〜と思{おも}います。", "ko": "~라고 생각해요.", "register": "polite", "example": {"ja": "おいしいと思{おも}います。", "ko": "맛있다고 생각해요."}},
  {"id": "sv-kanato", "cat": "opinion", "ja": "〜かなと思{おも}います。", "ko": "~인 것 같아요.", "register": "polite", "tip": "일본어는 단정하지 않고 「かな」로 부드럽게 말하는 걸 좋아해요. 예: 「こっちのほうがいいかなと思います。」"},
  {"id": "sv-watashi-wa", "cat": "opinion", "ja": "私{わたし}は〜派{は}です。", "ko": "저는 ~파예요.", "register": "polite", "example": {"ja": "私{わたし}は猫派{ねこは}です。", "ko": "저는 고양이파예요."}},
  {"id": "sv-dochiraka", "cat": "opinion", "ja": "どちらかというと…", "ko": "굳이 말하자면…", "register": "both"},
  {"id": "sv-tanoshii", "cat": "feeling", "ja": "楽{たの}しかったです。", "ko": "즐거웠어요.", "register": "polite"},
  {"id": "sv-yokatta", "cat": "feeling", "ja": "よかった！", "ko": "다행이다! / 잘됐다!", "register": "both", "tip": "좋은 소식을 들었을 때, 안심했을 때 둘 다 써요."},
  {"id": "sv-yabai", "cat": "feeling", "ja": "やばい！", "ko": "대박! / 큰일이다!", "register": "casual", "tip": "좋을 때도 나쁠 때도 써요. 말투와 상황으로 구분해요. 어른 앞에서는 피해요."},
  {"id": "sv-ureshii", "cat": "feeling", "ja": "うれしいです。", "ko": "기뻐요.", "register": "polite"},
  {"id": "sv-tsukareta", "cat": "feeling", "ja": "疲{つか}れました。", "ko": "피곤해요.", "register": "polite"},
  {"id": "sv-zannen", "cat": "feeling", "ja": "残念{ざんねん}です。", "ko": "아쉬워요.", "register": "polite"},
  {"id": "sv-bikkuri", "cat": "feeling", "ja": "びっくりしました。", "ko": "깜짝 놀랐어요.", "register": "polite"},
  {"id": "hs-ojama", "cat": "home_greet", "ja": "お邪魔{じゃま}します。", "ko": "실례하겠습니다. (남의 집에 들어갈 때)", "register": "polite", "tip": "직역은 '방해하겠습니다'. 홈스테이 첫날 현관에서, 친구 집에 놀러 갔을 때 신발을 벗으며 해요. 그 집에 같이 살게 된 뒤부터는 「ただいま」로 바꿔요."},
  {"id": "hs-ojamashimashita", "cat": "home_greet", "ja": "お邪魔{じゃま}しました。", "ko": "실례했습니다. (남의 집에서 나올 때)", "register": "polite", "tip": "친구 집에서 돌아갈 때. 「また来てね」(또 와)라고 하면 「ありがとうございます、また来ます！」"},
  {"id": "hs-ittekimasu", "cat": "home_greet", "ja": "いってきます。", "ko": "다녀오겠습니다. (집을 나설 때)", "register": "both", "example": {"ja": "じゃあ、学校{がっこう}にいってきます。", "ko": "그럼 학교 다녀올게요."}, "tip": "집을 나설 때 꼭 해요. 가족은 「いってらっしゃい」로 대답해요. 말없이 나가면 서운해할 수 있어요."},
  {"id": "hs-itterasshai", "cat": "home_greet", "ja": "いってらっしゃい。", "ko": "잘 다녀와요. (보내는 사람이)", "register": "both"},
  {"id": "hs-tadaima", "cat": "home_greet", "ja": "ただいま。", "ko": "다녀왔습니다. (집에 돌아왔을 때)", "register": "both", "tip": "현관문을 열자마자 크게. 가족은 「おかえり(なさい)」로 대답해요."},
  {"id": "hs-okaeri", "cat": "home_greet", "ja": "おかえりなさい。", "ko": "어서 와요. (돌아온 사람에게)", "register": "both"},
  {"id": "hs-ohayo", "cat": "home_greet", "ja": "おはようございます。", "ko": "안녕하세요. (아침 인사)", "register": "polite", "tip": "가족끼리는 금방 「おはよう」(반말)로 바뀌어요. 호스트 가족이 반말을 쓰기 시작하면 따라가도 돼요."},
  {"id": "hs-oyasumi", "cat": "home_greet", "ja": "おやすみなさい。", "ko": "안녕히 주무세요.", "register": "both"},
  {"id": "hs-shitsurei", "cat": "home_greet", "ja": "失礼{しつれい}します。", "ko": "실례합니다. (방에 들어갈 때)", "register": "polite", "tip": "노크하고 남의 방이나 교무실에 들어갈 때 해요. 나올 때는 「失礼しました」."},
  {"id": "hs-osewa", "cat": "home_greet", "ja": "お世話{せわ}になります。", "ko": "신세 지겠습니다. (첫날 인사)", "register": "polite", "example": {"ja": "今日{きょう}からお世話{せわ}になります。よろしくお願{ねが}いします。", "ko": "오늘부터 신세 지겠습니다. 잘 부탁드립니다."}, "tip": "직역은 '신세를 지게 됩니다'. 첫날 인사의 정석이에요. 「今日からお世話になります。よろしくお願いします。」를 통째로 외워 두세요."},
  {"id": "hs-omiyage", "cat": "home_greet", "ja": "これ、韓国{かんこく}のお菓子{かし}です。よかったら皆{みな}さんでどうぞ。", "ko": "이거 한국 과자예요. 괜찮으시면 다 같이 드세요.", "register": "polite", "tip": "「つまらないものですが」는 요즘엔 좀 딱딱하게 들려요. 「よかったら」(괜찮으시면)를 붙이는 게 자연스러워요."},
  {"id": "hs-itadakimasu", "cat": "home_meal", "ja": "いただきます。", "ko": "잘 먹겠습니다. (먹기 전)", "register": "both", "tip": "직역은 '(감사히) 받겠습니다'. 손을 모으고 말해요. 혼자 먹을 때도 작게 말하는 사람이 많아요."},
  {"id": "hs-gochisousama", "cat": "home_meal", "ja": "ごちそうさまでした。", "ko": "잘 먹었습니다. (먹은 후)", "register": "both", "tip": "다 먹고 그릇을 정리하면서 해요. 만든 사람에게 「おいしかったです」를 붙이면 최고예요."},
  {"id": "hs-oishisou", "cat": "home_meal", "ja": "わあ、おいしそう！", "ko": "와, 맛있겠다!", "register": "both", "tip": "음식이 나왔을 때 먹기 전에 하는 리액션이에요. 일본 사람들이 정말 자주 해요."},
  {"id": "hs-oishii", "cat": "home_meal", "ja": "すごくおいしいです！", "ko": "정말 맛있어요!", "register": "polite", "example": {"ja": "この味噌汁{みそしる}、すごくおいしいです！", "ko": "이 된장국 정말 맛있어요!"}, "tip": "말할 때는 「とても」보다 「すごく」가 자연스러워요. 친구끼리는 「めっちゃおいしい！」"},
  {"id": "hs-korewa", "cat": "home_meal", "ja": "これは何{なん}ですか。", "ko": "이건 뭐예요?", "register": "polite"},
  {"id": "hs-tokuni", "cat": "home_meal", "ja": "特{とく}にないです。何{なん}でも食{た}べられます。", "ko": "딱히 없어요. 뭐든 먹을 수 있어요.", "register": "polite", "tip": "「苦手な食べ物はある？」(못 먹는 거 있어?)라고 물으면 이렇게 대답해요. 정말 못 먹는 게 있으면 숨기지 말고 말하세요."},
  {"id": "hs-okawari", "cat": "home_meal", "ja": "おかわりしてもいいですか。", "ko": "더 먹어도 돼요?", "register": "polite", "tip": "직역은 '한 그릇 더'. 밥이나 국을 더 달라고 할 때 써요. 많이 먹으면 호스트 가족이 기뻐해요."},
  {"id": "hs-onaka", "cat": "home_meal", "ja": "もうお腹{なか}いっぱいです。", "ko": "이제 배불러요.", "register": "polite", "tip": "더 권하면 「ありがとうございます。でも、もうお腹いっぱいです」처럼 감사 + 거절을 같이 해요."},
  {"id": "hs-taberarenai", "cat": "home_meal", "ja": "すみません、〇〇は食{た}べられません。", "ko": "죄송해요, ○○은 못 먹어요. (알레르기·못 먹는 음식)", "register": "polite", "example": {"ja": "すみません、エビは食{た}べられません。", "ko": "죄송해요, 새우는 못 먹어요."}, "tip": "알레르기는 첫날 꼭 말해 두세요. 「アレルギーがあります」(알레르기가 있어요)도 같이 알아 두면 좋아요."},
  {"id": "hs-tetsudau", "cat": "home_meal", "ja": "何{なに}か手伝{てつだ}うことありますか。", "ko": "뭐 도울 일 있어요?", "register": "polite", "tip": "「手伝いましょうか」보다 부담 없이 들려요. 식사 준비나 정리할 때 먼저 물어보면 좋아요."},
  {"id": "hs-osara", "cat": "home_meal", "ja": "お皿{さら}、下{さ}げますね。", "ko": "그릇 치울게요.", "register": "polite", "tip": "다 먹은 그릇을 부엌으로 옮길 때 해요. 설거지까지 하려면 「洗いますね」."},
  {"id": "hs-chotto", "cat": "home_ask", "ja": "すみません、ちょっといいですか。", "ko": "저기요, 잠깐 괜찮으세요?", "register": "polite", "tip": "말을 걸 때 첫마디예요. 바로 용건부터 말하는 것보다 훨씬 자연스러워요."},
  {"id": "hs-ofuro", "cat": "home_ask", "ja": "お風呂{ふろ}に入{はい}ってもいいですか。", "ko": "목욕(샤워)해도 돼요?", "register": "polite", "tip": "일본은 욕조 물을 가족이 함께 써요. 욕조 밖에서 몸을 씻고, 다 쓴 물은 빼지 마세요. 순서는 호스트 가족에게 물어보세요."},
  {"id": "hs-osaki", "cat": "home_ask", "ja": "お風呂{ふろ}、お先{さき}にいただきました。", "ko": "먼저 목욕했어요. (감사의 뜻을 담은 인사)", "register": "polite", "tip": "목욕 순서를 양보받았을 때 나와서 하는 인사예요. 일본 가정 특유의 표현이에요."},
  {"id": "hs-otearai", "cat": "home_ask", "ja": "お手洗{てあら}い、お借{か}りしてもいいですか。", "ko": "화장실 좀 써도 될까요?", "register": "polite", "tip": "남의 집에서는 「トイレ」보다 「お手洗い」가 공손해요. 화장실을 '빌린다'(借りる)고 말하는 게 일본식이에요."},
