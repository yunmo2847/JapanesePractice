  {"id": "ch02-1", "day": 2, "kind": "chain", "start": {"ja": "毎朝{まいあさ}七時{しちじ}に起{お}きます。", "ko": "매일 아침 7시에 일어나요."}, "links": [{"label": "다음 일", "connector": "それから", "hint": "그러고 나서 아침을 먹어요", "example": {"ja": "それから、朝{あさ}ごはんを食{た}べます。", "ko": "그러고 나서 아침을 먹어요."}}, {"label": "이동", "connector": "", "hint": "8시에 버스로 학교에 가요", "example": {"ja": "八時{はちじ}にバスで学校{がっこう}に行{い}きます。", "ko": "8시에 버스로 학교에 가요."}}, {"label": "저녁", "connector": "", "hint": "밤에는 집에서 공부해요", "example": {"ja": "夜{よる}は家{いえ}で勉強{べんきょう}します。", "ko": "밤에는 집에서 공부해요."}}]},
  {"id": "ch02-2", "day": 2, "kind": "chain", "start": {"ja": "土曜日{どようび}は友達{ともだち}に会{あ}います。", "ko": "토요일에는 친구를 만나요."}, "links": [{"label": "장소", "connector": "", "hint": "카페에서 이야기해요 (話します)", "example": {"ja": "カフェで話{はな}します。", "ko": "카페에서 이야기해요."}}, {"label": "다음 일", "connector": "それから", "hint": "그러고 나서 쇼핑해요 (買い物します)", "example": {"ja": "それから、買{か}い物{もの}します。", "ko": "그러고 나서 쇼핑해요."}}, {"label": "귀가", "connector": "", "hint": "6시에 집에 돌아가요 (帰ります)", "example": {"ja": "六時{ろくじ}に家{いえ}に帰{かえ}ります。", "ko": "6시에 집에 돌아가요."}}]},
  {"id": "ch02-3", "day": 2, "kind": "chain", "start": {"ja": "学校{がっこう}で日本語{にほんご}を勉強{べんきょう}します。", "ko": "학교에서 일본어를 공부해요."}, "links": [{"label": "다음 일", "connector": "それから", "hint": "그러고 나서 점심을 먹어요 (昼ごはん)", "example": {"ja": "それから、昼{ひる}ごはんを食{た}べます。", "ko": "그러고 나서 점심을 먹어요."}}, {"label": "방과 후", "connector": "", "hint": "방과 후에 축구를 해요 (放課後・サッカー)", "example": {"ja": "放課後{ほうかご}はサッカーをします。", "ko": "방과 후에는 축구를 해요."}}, {"label": "저녁", "connector": "", "hint": "집에서 동영상을 봐요", "example": {"ja": "家{いえ}で動画{どうが}を見{み}ます。", "ko": "집에서 동영상을 봐요."}}]},
  {"id": "ch03-1", "day": 3, "kind": "formula", "start": {"ja": "好{す}きな食{た}べ物{もの}は何{なん}ですか。", "ko": "좋아하는 음식이 뭐예요?"}, "links": [{"label": "답", "connector": "", "hint": "라멘을 좋아해요", "example": {"ja": "ラーメンが好{す}きです。", "ko": "라멘을 좋아해요."}}, {"label": "이유", "connector": "から", "hint": "맛있고 싸니까요", "example": {"ja": "おいしくて安{やす}いからです。", "ko": "맛있고 싸니까요."}}, {"label": "덧붙이기", "connector": "", "hint": "일주일에 두 번 먹어요 (週に二回)", "example": {"ja": "週{しゅう}に二回{にかい}食{た}べます。", "ko": "일주일에 두 번 먹어요."}}, {"label": "되묻기", "connector": "", "hint": "유이 씨는요?", "example": {"ja": "ユイさんは?", "ko": "유이 씨는요?"}}]},
  {"id": "ch03-2", "day": 3, "kind": "formula", "start": {"ja": "辛{から}いものは好{す}きですか。", "ko": "매운 거 좋아해요?"}, "links": [{"label": "답", "connector": "", "hint": "네, 정말 좋아해요", "example": {"ja": "はい、大好{だいす}きです。", "ko": "네, 정말 좋아해요."}}, {"label": "이유", "connector": "から", "hint": "한국 음식은 매우니까요", "example": {"ja": "韓国{かんこく}の料理{りょうり}は辛{から}いからです。", "ko": "한국 음식은 매우니까요."}}, {"label": "덧붙이기", "connector": "", "hint": "김치찌개를 제일 좋아해요", "example": {"ja": "キムチチゲが一番{いちばん}好{す}きです。", "ko": "김치찌개를 제일 좋아해요."}}, {"label": "되묻기", "connector": "", "hint": "유이 씨는 매운 거 괜찮아요? (大丈夫)", "example": {"ja": "ユイさんは辛{から}いもの、大丈夫{だいじょうぶ}ですか。", "ko": "유이 씨는 매운 거 괜찮아요?"}}]},
  {"id": "ch03-3", "day": 3, "kind": "formula", "start": {"ja": "苦手{にがて}な食{た}べ物{もの}はありますか。", "ko": "잘 못 먹는 음식 있어요?"}, "links": [{"label": "답", "connector": "", "hint": "생선을 잘 못 먹어요", "example": {"ja": "魚{さかな}が苦手{にがて}です。", "ko": "생선을 잘 못 먹어요."}}, {"label": "이유", "connector": "から", "hint": "냄새가 싫으니까요 (におい)", "example": {"ja": "においが苦手{にがて}だからです。", "ko": "냄새를 잘 못 견뎌서요."}}, {"label": "덧붙이기", "connector": "でも", "hint": "하지만 초밥은 좋아해요", "example": {"ja": "でも、お寿司{すし}は好{す}きです。", "ko": "하지만 초밥은 좋아해요."}}, {"label": "되묻기", "connector": "", "hint": "유이 씨는요?", "example": {"ja": "ユイさんは?", "ko": "유이 씨는요?"}}]},
  {"id": "ch04-1", "day": 4, "kind": "formula", "start": {"ja": "やってみたいことはありますか。", "ko": "해보고 싶은 거 있어요?"}, "links": [{"label": "답", "connector": "", "hint": "일본에 가고 싶어요", "example": {"ja": "日本{にほん}に行{い}きたいです。", "ko": "일본에 가고 싶어요."}}, {"label": "예시", "connector": "例えば", "hint": "예를 들면 교토에서 절을 보고 싶어요 (お寺)", "example": {"ja": "例{たと}えば、京都{きょうと}でお寺{てら}を見{み}たいです。", "ko": "예를 들면 교토에서 절을 보고 싶어요."}}, {"label": "이유", "connector": "から", "hint": "역사를 좋아하니까요 (歴史)", "example": {"ja": "歴史{れきし}が好{す}きだからです。", "ko": "역사를 좋아하니까요."}}, {"label": "되묻기", "connector": "", "hint": "유이 씨는 뭘 하고 싶어요?", "example": {"ja": "ユイさんは何{なに}がしたいですか。", "ko": "유이 씨는 뭘 하고 싶어요?"}}]},
  {"id": "ch04-2", "day": 4, "kind": "formula", "start": {"ja": "週末{しゅうまつ}は何{なに}をするつもりですか。", "ko": "주말에 뭐 할 생각이에요?"}, "links": [{"label": "답", "connector": "", "hint": "친구랑 영화를 볼 생각이에요", "example": {"ja": "友達{ともだち}と映画{えいが}を見{み}るつもりです。", "ko": "친구랑 영화를 볼 생각이에요."}}, {"label": "예시", "connector": "例えば", "hint": "예를 들면 애니메이션 영화요 (アニメ)", "example": {"ja": "例{たと}えば、アニメの映画{えいが}です。", "ko": "예를 들면 애니메이션 영화요."}}, {"label": "덧붙이기", "connector": "それから", "hint": "그러고 나서 맛있는 걸 먹고 싶어요", "example": {"ja": "それから、おいしいものを食{た}べたいです。", "ko": "그러고 나서 맛있는 걸 먹고 싶어요."}}, {"label": "되묻기", "connector": "", "hint": "유이 씨는요?", "example": {"ja": "ユイさんは?", "ko": "유이 씨는요?"}}]},
  {"id": "ch04-3", "day": 4, "kind": "chain", "start": {"ja": "もっと日本語{にほんご}が上手{じょうず}になりたいです。", "ko": "일본어를 더 잘하고 싶어요."}, "links": [{"label": "결과", "connector": "だから", "hint": "그래서 매일 공부해요", "example": {"ja": "だから、毎日{まいにち}勉強{べんきょう}します。", "ko": "그래서 매일 공부해요."}}, {"label": "예시", "connector": "例えば", "hint": "예를 들면 일본 드라마를 봐요", "example": {"ja": "例{たと}えば、日本{にほん}のドラマを見{み}ます。", "ko": "예를 들면 일본 드라마를 봐요."}}, {"label": "계획", "connector": "", "hint": "내년에 시험을 볼 생각이에요 (試験を受ける)", "example": {"ja": "来年{らいねん}、試験{しけん}を受{う}けるつもりです。", "ko": "내년에 시험을 볼 생각이에요."}}]},
  {"id": "ch05-1", "day": 5, "kind": "chain", "start": {"ja": "私{わたし}の部屋{へや}は狭{せま}いです。", "ko": "제 방은 좁아요."}, "links": [{"label": "반대", "connector": "でも", "hint": "하지만 밝아요", "example": {"ja": "でも、明{あか}るいです。", "ko": "하지만 밝아요."}}, {"label": "묘사", "connector": "", "hint": "창문이 커서 좋아요 (窓)", "example": {"ja": "窓{まど}が大{おお}きくていいです。", "ko": "창문이 커서 좋아요."}}, {"label": "덧붙이기", "connector": "", "hint": "침대와 책상이 있어요 (あります)", "example": {"ja": "ベッドと机{つくえ}があります。", "ko": "침대와 책상이 있어요."}}]},
  {"id": "ch05-2", "day": 5, "kind": "formula", "start": {"ja": "どんな町{まち}に住{す}んでいますか。", "ko": "어떤 동네에 살아요?"}, "links": [{"label": "답", "connector": "", "hint": "조용한 동네예요", "example": {"ja": "静{しず}かな町{まち}です。", "ko": "조용한 동네예요."}}, {"label": "이유", "connector": "から", "hint": "역이 가까워서 편리해요", "example": {"ja": "駅{えき}が近{ちか}いから、便利{べんり}です。", "ko": "역이 가까워서 편리해요."}}, {"label": "반대", "connector": "でも", "hint": "하지만 가게는 별로 없어요 (店・多くない)", "example": {"ja": "でも、店{みせ}はあまり多{おお}くないです。", "ko": "하지만 가게는 별로 많지 않아요."}}, {"label": "되묻기", "connector": "", "hint": "유이 씨 동네는 어때요?", "example": {"ja": "ユイさんの町{まち}はどうですか。", "ko": "유이 씨 동네는 어때요?"}}]},
